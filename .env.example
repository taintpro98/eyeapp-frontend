# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
# Backend domain — no path suffix (e.g. http://localhost:8080)
VITE_BACKEND_URL=http://localhost:8080

# Cloudflare Workers AI Endpoint for Lumi Chat
VITE_LUMI_WORKER_URL=https://eyeapp-lumi.taideptrai02.workers.dev


# ──────────────────────────────────────────────
# Signals page
# ──────────────────────────────────────────────
# Orders per page (default: 20)
VITE_ORDERS_PAGE_SIZE=20

# ──────────────────────────────────────────────
# OAuth (leave empty if not using social login)
# ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# ──────────────────────────────────────────────
# Lumi chat agent (api/agent.ts — Vercel Function; locally the agent-api compose service)
# Server-side only: set these in Vercel project env, and locally in .env.agent.local (gitignored).
# ──────────────────────────────────────────────
# LLM_ROUTER_BASE_URL=https://your-openai-compatible-router   # "/v1" is appended if missing
# LLM_ROUTER_API_KEY=
# LLM_MODEL=ep/gemini-3.5-flash-lite
# BACKEND_URL=https://eyeapp-backend.fly.dev                  # eyeapp-backend origin (falls back to VITE_BACKEND_URL)
